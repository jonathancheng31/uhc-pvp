root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.gd]
indent_style = tab
indent_size = 4

[*.{md,yml,yaml,sh,py}]
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.cs]
indent_style = space
indent_size = 4
# "Flags" is the clearest suffix for [Flags] enums in game code.
dotnet_diagnostic.CA1711.severity = none
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true

[tests/**.cs]
# Test methods are discovered as instance methods, even when they don't touch instance data.
dotnet_diagnostic.CA1822.severity = none
